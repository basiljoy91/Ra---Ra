# Public site configuration
NEXT_PUBLIC_SITE_URL=

# Shopify Storefront API (keep the private token server-only)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_DEFAULT_COUNTRY=DE
# Germany-only launch. Use EU only after additional markets and policies are approved.
SHOPIFY_MARKET_MODE=DE

# Optional cart services (server-only). Both gift-wrap values are required to
# render the paid service. Configure only merchant-approved shipping thresholds.
SHOPIFY_GIFT_WRAP_VARIANT_ID=
SHOPIFY_GIFT_WRAP_PRODUCT_HANDLE=
SHOPIFY_FREE_SHIPPING_THRESHOLD_IN=
SHOPIFY_FREE_SHIPPING_CURRENCY_IN=INR
SHOPIFY_FREE_SHIPPING_SUBTOTAL_BASIS=
# Example market pair: SHOPIFY_FREE_SHIPPING_THRESHOLD_DE= and
# SHOPIFY_FREE_SHIPPING_CURRENCY_DE=EUR

# Future content integration
CMS_API_URL=
CMS_API_TOKEN=

# Future optional services
NEWSLETTER_PROVIDER=
ANALYTICS_PROVIDER=

# Legal/contact delivery (server-only). The endpoint must durably persist
# withdrawal declarations and queue immediate customer acknowledgement emails.
RA_LEGAL_SUBMISSION_ENDPOINT=
RA_LEGAL_SUBMISSION_SECRET=
RA_LEGAL_RATE_LIMIT_SALT=
